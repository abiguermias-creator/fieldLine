generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, citext]
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.Citext
  passwordHash      String             @map("password_hash")
  fullName          String             @map("full_name")
  role              UserRole
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(6)
  clientId          String?            @map("client_id") @db.Uuid
  refreshTokens     RefreshToken[]
  technicianProfile TechnicianProfile?
  client            Client?            @relation(fields: [clientId], references: [id])
  workOrderEvents   WorkOrderEvent[]
  notifications     Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Client {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  email       String?     @db.Citext
  phone       String?
  address     String?
  contactName String?     @map("contact_name")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  isActive    Boolean     @default(true) @map("is_active")
  sites       Site[]
  users       User[]
  workOrders  WorkOrder[]

  @@map("clients")
}

model Site {
  id                   String      @id @default(uuid()) @db.Uuid
  clientId             String      @map("client_id") @db.Uuid
  name                 String
  address              String
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  accessNotes          String?     @map("access_notes")
  city                 String?
  isActive             Boolean     @default(true) @map("is_active")
  latitude             Float?
  longitude            Float?
  coordinatesManual    Boolean     @default(false) @map("coordinates_manual")
  needsManualPlacement Boolean     @default(false) @map("needs_manual_placement")
  client               Client      @relation(fields: [clientId], references: [id])
  workOrders           WorkOrder[]

  @@map("sites")
}

model GeocodeCache {
  id        String   @id @default(uuid()) @db.Uuid
  address   String
  city      String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([address, city])
  @@map("geocode_cache")
}

model RoutingCache {
  id            String   @id @default(uuid()) @db.Uuid
  fromLatitude  Float    @map("from_latitude")
  fromLongitude Float    @map("from_longitude")
  toLatitude    Float    @map("to_latitude")
  toLongitude   Float    @map("to_longitude")
  travelMinutes Int      @map("travel_minutes")
  distanceKm    Float?   @map("distance_km")
  source        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fromLatitude, fromLongitude, toLatitude, toLongitude])
  @@map("routing_cache")
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrderSkills  WorkOrderSkill[]
  technicianSkills TechnicianSkill[]

  @@map("skills")
}

model TechnicianProfile {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  employeeCode            String    @unique @map("employee_code")
  baseLocation            String    @map("base_location")
  currentLatitude         Float?
  currentLongitude        Float?
  lastLocationAt          DateTime? @map("last_location_at") @db.Timestamptz(6)
  locationSharingEnabled  Boolean   @default(true) @map("location_sharing_enabled")
  maxWorkingMinutesPerDay Int       @default(480) @map("max_working_minutes_per_day")
  phone                   String?
  bio                     String?
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrders       WorkOrder[]
  technicianSkills TechnicianSkill[]
  workLogs         WorkLog[]

  @@map("technician_profiles")
}

model Equipment {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  category     String
  description  String?
  serialNumber String?  @unique @map("serial_number")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrders WorkOrder[]

  @@map("equipment")
}

model WorkOrder {
  id                        String            @id @default(uuid()) @db.Uuid
  reference                 String            @unique
  clientId                  String            @map("client_id") @db.Uuid
  siteId                    String            @map("site_id") @db.Uuid
  title                     String
  description               String?
  isOutdoor                 Boolean           @default(false) @map("is_outdoor")
  cancellationReason        String?           @map("cancellation_reason")
  waitingOnPartsDescription String?           @map("waiting_on_parts_description")
  status                    WorkOrderStatus   @default(NEW)
  priority                  WorkOrderPriority @default(P3)
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  scheduledAt               DateTime?         @map("scheduled_at") @db.Timestamptz(6)
  scheduledEndAt            DateTime?         @map("scheduled_end_at") @db.Timestamptz(6)
  arrivedAt                 DateTime?         @map("arrived_at") @db.Timestamptz(6)
  estimatedDuration         Int?              @map("estimated_duration")
  dailyHoursOverride        Boolean           @default(false) @map("daily_hours_override")
  dailyHoursOverrideReason  String?           @map("daily_hours_override_reason")
  dailyHoursOverrideRules   String?           @map("daily_hours_override_rules")
  agreedDate                DateTime?         @map("agreed_date") @db.Timestamptz(6)
  slaRespondBy              DateTime?         @map("sla_respond_by") @db.Timestamptz(6)
  slaResolveBy              DateTime?         @map("sla_resolve_by") @db.Timestamptz(6)
  technicianId              String?           @map("technician_id") @db.Uuid
  equipmentId               String?           @map("equipment_id") @db.Uuid
  originalWorkOrderId       String?           @map("original_work_order_id") @db.Uuid

  originalWorkOrder  WorkOrder?  @relation("WorkOrderFollowUp", fields: [originalWorkOrderId], references: [id])
  followUpWorkOrders WorkOrder[] @relation("WorkOrderFollowUp")

  client          Client             @relation(fields: [clientId], references: [id])
  site            Site               @relation(fields: [siteId], references: [id])
  technician      TechnicianProfile? @relation(fields: [technicianId], references: [id])
  workOrderSkills WorkOrderSkill[]
  equipment       Equipment?         @relation(fields: [equipmentId], references: [id])
  events          WorkOrderEvent[]
  workLogs        WorkLog[]
  photos          WorkOrderPhoto[]

  @@map("work_orders")
}

model WorkOrderEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  eventType   String   @map("event_type")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id])

  @@map("work_order_events")
}

model WorkLog {
  id           String   @id @default(uuid()) @db.Uuid
  workOrderId  String   @map("work_order_id") @db.Uuid
  technicianId String   @map("technician_id") @db.Uuid
  note         String
  minutesSpent Int      @map("minutes_spent")
  partsUsed    String?  @map("parts_used")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder  WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([workOrderId, createdAt])
  @@map("work_logs")
}

model WorkOrderPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  fileSize    Int      @map("file_size")
  filePath    String   @map("file_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@map("work_order_photos")
}

model WorkOrderSequence {
  year       Int      @id
  lastNumber Int      @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("work_order_sequences")
}

model WorkOrderSkill {
  workOrderId String @map("work_order_id") @db.Uuid
  skillId     String @map("skill_id") @db.Uuid

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([workOrderId, skillId])
  @@map("work_order_skills")
}

model TechnicianSkill {
  technicianId           String    @map("technician_id") @db.Uuid
  skillId                String    @map("skill_id") @db.Uuid
  certificationExpiresAt DateTime? @map("certification_expires_at") @db.Timestamptz(6)

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([technicianId, skillId])
  @@map("technician_skills")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum WorkOrderStatus {
  NEW
  TRIAGED
  ASSIGNED
  SCHEDULED
  EN_ROUTE
  ON_SITE
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CLOSED
  CANCELLED
}

enum WorkOrderPriority {
  P1
  P2
  P3
  P4
}

enum UserRole {
  CLIENT
  TECHNICIAN
  DISPATCHER
  SUPERVISOR
}
